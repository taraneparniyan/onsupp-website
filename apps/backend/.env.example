# Server Configuration
PORT=3002
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/onsupp_db?schema=public"

# Security (Generate a secure 64-char string for production)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Initial Admin Credentials (used during npm run seed)
ADMIN_EMAIL="admin@onsupp.ir"
ADMIN_PASSWORD="Admin@OnSupp2026!"

# CORS and Client URLs
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3004"
