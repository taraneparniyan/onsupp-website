generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  PERCENTAGE
  IMAGE
  LINK
  BEFORE_AFTER
  TEXTAREA
  SELECT
  MULTI_SELECT
  BOOLEAN
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String?
  role       Role       @default(USER)
  isActive   Boolean    @default(true)
  phone      String?
  department String?
  position   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  auditLogs  AuditLog[]

  @@map("users")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  targetId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String
  filename  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

model HeroSlide {
  id          Int               @id @default(autoincrement())
  title       String            @default("")
  titleEn     String            @default("")
  subtitle    String            @default("")
  subtitleEn  String            @default("")
  ctaText     String            @default("")
  ctaTextEn   String            @default("")
  ctaLink     String            @default("")
  ctaText2    String            @default("")
  ctaText2En  String            @default("")
  ctaLink2    String            @default("")
  imageUrl    String?
  imageAlt    String?
  position    Int               @default(0)
  isPublished Boolean           @default(true)
  status      PublicationStatus @default(PUBLISHED)
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())

  @@index([position])
  @@index([isPublished])
  @@map("hero_slide")
}

model Service {
  id                   Int               @id @default(autoincrement())
  slug                 String            @default("")
  title                String            @default("")
  titleEn              String            @default("")
  subtitle             String            @default("")
  subtitleEn           String            @default("")
  tagFa                String            @default("")
  tagEn                String            @default("")
  headlineFa           String            @default("")
  headlineEn           String            @default("")
  detailedNarrativeFa  String            @default("")
  detailedNarrativeEn  String            @default("")
  businessValueTitleFa String            @default("")
  businessValueTitleEn String            @default("")
  businessValueFa      String            @default("")
  businessValueEn      String            @default("")
  imageUrl             String?
  imageAlt             String?
  coverImage           String?
  gallery              Json              @default("[]")
  iconType             String            @default("web")
  badgeAccentFa        String?
  badgeAccentEn        String?
  ctaLabelFa           String            @default("درخواست مشاوره این خدمت")
  ctaLabelEn           String            @default("Request Service Consultation")
  subservices          Json              @default("[]") // Array of { nameFa, nameEn, descFa, descEn, deliverablesFa: string[], deliverablesEn: string[] }
  deliverablesFa       String[]          @default([])
  deliverablesEn       String[]          @default([])
  metrics              Json              @default("[]") // Array of { valueFa, valueEn, labelFa, labelEn }
  relatedLinks         Json              @default("[]") // Array of { titleFa, titleEn, href, type }
  metaTitleFa          String            @default("")
  metaTitleEn          String            @default("")
  metaDescFa           String            @default("")
  metaDescEn           String            @default("")
  keywords             String            @default("")
  canonicalUrl         String            @default("")
  ogImage              String            @default("")
  focusKeyword         String            @default("")
  secondaryKeywords    String[]          @default([])
  isPillar             Boolean           @default(false)
  seoConfig            Json              @default("{}")
  position             Int               @default(0)
  isPublished          Boolean           @default(true)
  status               PublicationStatus @default(PUBLISHED)
  updatedAt            DateTime          @updatedAt
  createdAt            DateTime          @default(now())

  @@index([position])
  @@index([slug])
  @@index([isPublished])
  @@index([focusKeyword])
  @@index([isPillar])
  @@map("services")
}

model Stat {
  id          Int               @id @default(autoincrement())
  kind        String            @default("number")
  valueFa     String            @default("")
  valueEn     String            @default("")
  labelFa     String            @default("")
  labelEn     String            @default("")
  descFa      String            @default("")
  descEn      String            @default("")
  position    Int               @default(0)
  isPublished Boolean           @default(true)
  status      PublicationStatus @default(PUBLISHED)
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())

  @@index([position])
  @@index([isPublished])
  @@map("stats")
}

model AboutContent {
  id            Int      @id @default(1)
  eyebrowFa     String   @default("")
  eyebrowEn     String   @default("")
  titleFa       String   @default("")
  titleEn       String   @default("")
  ctaFa         String   @default("")
  ctaEn         String   @default("")
  ctaLink       String   @default("#contact")
  imageUrl      String?
  imageAlt      String?
  subTitleFa    String   @default("")
  subTitleEn    String   @default("")
  paragraphFa   String   @default("")
  paragraphEn   String   @default("")
  
  // Extended fields for dedicated /about page hero & narrative
  heroCaptionFa String   @default("تیم آن‌ساپ — تهران")
  heroCaptionEn String   @default("The OnSupp team — Tehran")
  leadFa        String   @default("آن‌ساپ یک آژانس دیجیتال است که استراتژی، طراحی، فناوری و رسانه را زیر یک سقف کنار هم آورده است.")
  leadEn        String   @default("OnSupp is a digital agency that brings strategy, design, technology and media together under one roof.")
