model Feature {
  id        Int      @id @default(autoincrement())
  titleFa   String   @default("")
  titleEn   String   @default("")
  icon      String   @default("team")
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("features")
}

model CeoProfile {
  id          Int               @id @default(1)
  nameFa      String            @default("نام مدیرعامل")
  nameEn      String            @default("CEO Name")
  roleFa      String            @default("بنیان‌گذار و مدیرعامل")
  roleEn      String            @default("Founder & CEO")
  quoteFa     String            @default("ما آن‌ساپ را ساختیم تا برندها مجبور نباشند بین خلاقیت و نتیجه یکی را انتخاب کنند.")
  quoteEn     String            @default("We built OnSupp so brands never have to choose between creativity and results.")
  bioFa       String[]          @default([])
  bioEn       String[]          @default([])
  avatarUrl   String?
  focalPoint  String            @default("50% 50%")
  socialLinks Json              @default("[]") // Array of { platform, url }
  isPublished Boolean           @default(true)
  status      PublicationStatus @default(PUBLISHED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("ceo_profile")
}

model CompanyValue {
  id            Int               @id @default(autoincrement())
  key           String            @unique // e.g. "clarity", "craft", "partnership"
  titleFa       String
  titleEn       String
  descriptionFa String
  descriptionEn String
  badgeFa       String            @default("")
  badgeEn       String            @default("")
  icon          String            @default("check")
  position      Int               @default(0)
  isPublished   Boolean           @default(true)
  status        PublicationStatus @default(PUBLISHED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([position])
  @@index([isPublished])
  @@map("company_values")
}

model TeamMember {
  id               Int               @id @default(autoincrement())
  nameFa           String
  nameEn           String
  roleFa           String
  roleEn           String
  departmentFa     String
  departmentEn     String
  bioFa            String            @default("")
  bioEn            String            @default("")
  avatarUrl        String?
  additionalImages Json              @default("[]") // Array of image URLs
  focalPoint       String            @default("50% 50%")
  socialLinks      Json              @default("[]") // Array of { platform, url }
  position         Int               @default(0)
  isPublished      Boolean           @default(true)
  status           PublicationStatus @default(PUBLISHED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([position])
  @@index([isPublished])
  @@map("team_members")
}

model ClientPartner {
  id              Int               @id @default(autoincrement())
  slug            String            @unique
  orderNumber     String            @default("01")
  nameFa          String
  nameEn          String
  titleFa         String
  titleEn         String
  industryFa      String
  industryEn      String
  introFa         String
  introEn         String
  quoteFa         String?
  quoteEn         String?
  yearFa          String            @default("۱۴۰۳")
  yearEn          String            @default("2024")
  monogram        String            @default("ON")
  portraitImage   String?
  portraitBadgeFa String?
  portraitBadgeEn String?
  websites        Json              @default("[]") // Array of { url, label }
  instagrams      Json              @default("[]") // Array of { handle, profileUrl, name }
  servicesFa      String[]          @default([])
  servicesEn      String[]          @default([])
  position        Int               @default(0)
  isFeatured      Boolean           @default(true)
  isPublished     Boolean           @default(true)
  status          PublicationStatus @default(PUBLISHED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([position])
  @@index([isPublished])
  @@index([slug])
  @@map("client_partners")
}

model ClientLogo {
  id          Int               @id @default(autoincrement())
  key         String            @unique // e.g. "sina-parsipour", "night-sky"
  nameFa      String
  nameEn      String
  logoUrl     String
  darkLogoUrl String?
  altFa       String            @default("")
  altEn       String            @default("")
  width       Int               @default(300)
  height      Int               @default(120)
  linkUrl     String?           @default("#")
  position    Int               @default(0)
  isPublished Boolean           @default(true)
  status      PublicationStatus @default(PUBLISHED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([position])
  @@index([isPublished])
  @@map("client_logos")
}

model HomepageSection {
  id           Int      @id @default(autoincrement())
  key          String   @unique // e.g. "hero", "clients-partners", "stats", "services", "about", "client-marquee", "casestudies", "contact-cta", "testimonials", "blog-articles"
  sectionType  String   @default("standard")
  titleFa      String   @default("")
  titleEn      String   @default("")
  position     Int      @default(0)
  isEnabled    Boolean  @default(true)
  settingsJson Json     @default("{}") // Configurable content references & section behavior options
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
  @@index([isEnabled])
  @@map("homepage_sections")
}

