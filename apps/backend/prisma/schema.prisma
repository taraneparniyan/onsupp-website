model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  subject   String?
  service   String   @default("seo")
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@map("contact_submissions")
}

model Article {
  id         Int     @id @default(autoincrement())
  titleFa    String  @default("")
  titleEn    String  @default("")
  slug       String  @unique
  language   String  @default("fa")
  categoryFa String  @default("آموزش سئو")
  categoryEn String  @default("SEO Tutorial")
  excerptFa  String  @default("")
  excerptEn  String  @default("")
  contentFa  String  @default("")
  contentEn  String  @default("")
  readTimeFa String  @default("۵ دقیقه مطالعه")
  readTimeEn String  @default("5 min read")
  imageUrl   String  @default("")
  author     String  @default("آن‌ساپ")
  published  Boolean @default(true)

  // Optional 1-to-1 Translation Link to an Article in another language
  translationId  Int?      @unique
  translation    Article?  @relation("ArticleTranslation", fields: [translationId], references: [id], onDelete: SetNull)
  translatedFrom Article?  @relation("ArticleTranslation")

  // SEO Meta Fields
  metaTitleFa       String   @default("")
  metaTitleEn       String   @default("")
  metaDescFa        String   @default("")
  metaDescEn        String   @default("")
  keywordsFa        String   @default("")
  keywordsEn        String   @default("")
  canonicalUrl      String   @default("")
  ogImage           String   @default("")
  focusKeyword      String   @default("")
  secondaryKeywords String[] @default([])
  isPillar          Boolean  @default(false)
  seoConfig         Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  faqs     ArticleFaq[]

  @@index([published])
  @@index([createdAt])
  @@index([language])
  @@index([focusKeyword])
  @@index([isPillar])
  @@map("articles")
}

model ArticleFaq {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@map("article_faqs")
}

model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String
  approved  Boolean  @default(false)
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([approved])
  @@map("comments")
}

model Testimonial {
  id           Int               @id @default(autoincrement())
  quoteFa      String
  quoteEn      String            @default("")
  authorFa     String
  authorEn     String            @default("")
  roleFa       String            @default("")
  roleEn       String            @default("")
  companyFa    String?
  companyEn    String?
  serviceTagFa String?
  serviceTagEn String?
  highlightFa  String?
  highlightEn  String?
  avatarUrl    String?
  isActive     Boolean           @default(true)
  status       PublicationStatus @default(PUBLISHED)
  position     Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([isActive])
  @@index([position])
  @@map("testimonials")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  EMPLOYEE
  CONTENT_SEO_MANAGER
  SUPPORT
  PROJECT_MANAGER
  USER
}
