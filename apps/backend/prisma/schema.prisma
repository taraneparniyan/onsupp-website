model CaseStudy {
  id             Int               @id @default(autoincrement())
  slug           String            @default("")
  client         String            @default("")
  clientEn       String            @default("")
  titleFa        String            @default("")
  titleEn        String            @default("")
  taglineFa      String            @default("")
  taglineEn      String            @default("")
  categoryFa     String            @default("")
  categoryEn     String            @default("")
  projectType    String            @default("website")
  descriptionFa  String            @default("")
  descriptionEn  String            @default("")
  imageUrl       String?
  secondaryImage String?
  gallery        Json              @default("[]") // Array of image URLs
  liveUrl        String            @default("#")
  featured       Boolean           @default(true)
  position       Int               @default(0)
  year           String            @default("۲۰۲۵")

  // Extended project history and delivery fields
  challengeFa    String            @default("")
  challengeEn    String            @default("")
  solutionFa     String            @default("")
  solutionEn     String            @default("")
  resultsFa      String            @default("")
  resultsEn      String            @default("")
  deliverablesFa String[]          @default([])
  deliverablesEn String[]          @default([])
  servicesFa     String[]          @default([])
  servicesEn     String[]          @default([])
  metricsFa      Json              @default("[]") // Array of { value, label }
  metricsEn      Json              @default("[]")
  colorGradient  String            @default("from-[#1a1315] via-[#241a1e] to-[#100b0d]")
  accentColor    String            @default("#D4A5A8")
  glowColor      String            @default("rgba(212, 165, 168, 0.2)")
  previewType    String            @default("web") // "mobile" | "web" | "platform"

  // SEO Metadata
  metaTitleFa    String            @default("")
  metaTitleEn    String            @default("")
  metaDescFa     String            @default("")
  metaDescEn     String            @default("")
  keywords       String            @default("")
  ogImage        String            @default("")

  // Dynamic Category & Custom Attribute Relations
  categoryId      Int?
  category        PortfolioCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attributeValues PortfolioAttributeValue[]

  isPublished    Boolean           @default(true)
  status         PublicationStatus @default(PUBLISHED)
  updatedAt      DateTime          @updatedAt
  createdAt      DateTime          @default(now())

  @@index([position])
  @@index([slug])
  @@index([isPublished])
  @@index([categoryId])
  @@map("case_studies")
}

model PortfolioCategory {
  id            Int                          @id @default(autoincrement())
  slug          String                       @unique
  titleFa       String
  titleEn       String
  descriptionFa String                       @default("")
  descriptionEn String                       @default("")
  icon          String                       @default("folder")
  color         String                       @default("#38534A")
  position      Int                          @default(0)
  isActive      Boolean                      @default(true)
  attributes    PortfolioAttributeTemplate[]
  caseStudies   CaseStudy[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([position])
  @@index([isActive])
  @@index([slug])
  @@map("portfolio_categories")
}

model PortfolioAttributeTemplate {
  id             Int                       @id @default(autoincrement())
  categoryId     Int
  category       PortfolioCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key            String                    // e.g. "tech_stack", "organic_clicks", "before_after_seo"
  titleFa        String
  titleEn        String
  descriptionFa  String                    @default("")
  descriptionEn  String                    @default("")
  type           AttributeType             @default(TEXT)
  isRequired     Boolean                   @default(false)
  unit           String                    @default("") // e.g. "٪", "رتبه", "کلیک"
  showInFrontend Boolean                   @default(true)
  position       Int                       @default(0)
  isActive       Boolean                   @default(true)
  options        Json                      @default("{}") // For extra settings, min/max, placeholders
  values         PortfolioAttributeValue[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId])
  @@index([position])
  @@index([isActive])
  @@map("portfolio_attribute_templates")
}

model PortfolioAttributeValue {
  id           Int                         @id @default(autoincrement())
  caseStudyId  Int
  caseStudy    CaseStudy                   @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  attributeId  Int?
  attribute    PortfolioAttributeTemplate? @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  attributeKey String                      // Denormalized key for historical stability
  type         AttributeType               @default(TEXT)
  valueText    String?
  valueNumber  Float?
  valueJson    Json?                       // Complex payloads: { before, after } or { url, label }
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([caseStudyId, attributeKey])
  @@index([caseStudyId])
  @@index([attributeId])
  @@map("portfolio_attribute_values")
}

model PricingCategory {
  id        Int           @id @default(autoincrement())
  titleFa   String        @default("")
  titleEn   String        @default("")
  slug      String        @unique
  position  Int           @default(0)
  plans     PricingPlan[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("pricing_categories")
}

model PricingPlan {
  id              Int               @id @default(autoincrement())
  categoryId      Int
  category        PricingCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameFa          String            @default("")
  nameEn          String            @default("")
  badgeFa         String            @default("")
  badgeEn         String            @default("")
  priceType       String            @default("numeric") // "numeric" | "contact"
  priceFa         String            @default("")
  priceEn         String            @default("")
  discountPriceFa String            @default("") // Off / Sale price (optional)
  discountPriceEn String            @default("")
  periodFa        String            @default("")
  periodEn        String            @default("")
  descriptionFa   String            @default("")
  descriptionEn   String            @default("")
  featuresFa      String[]          @default([])
  featuresEn      String[]          @default([])
  popular         Boolean           @default(false)
  ctaFa           String            @default("")
  ctaEn           String            @default("")
  ctaLink         String            @default("#contact")
  position        Int               @default(0)
  isPublished     Boolean           @default(true)
  status          PublicationStatus @default(PUBLISHED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@map("pricing_plans")
}

model ContactContent {
  id             Int      @id @default(1)
  eyebrowFa      String   @default("شروع همکاری و مشاوره اختصاصی")
  eyebrowEn      String   @default("LET'S WORK TOGETHER")
